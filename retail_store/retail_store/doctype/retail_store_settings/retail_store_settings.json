  {
   "fieldname": "apply_brand_to_desk",
   "fieldtype": "Check",
   "label": "Apply Brand Colours to Desk",
   "default": "1",
   "description": "Maps the brand colour onto Desk's primary colour. Turn this off if a Desk theme app is installed and should own the colours.",
   "permlevel": 1
  },
  {
   "permlevel": 1,
   "fieldname": "storefront_section",
   "fieldtype": "Section Break",
   "label": "Storefront Home Page"
  },
  {
   "permlevel": 1,
   "fieldname": "storefront_headline",
   "fieldtype": "Data",
   "label": "Headline",
   "description": "Large text on the home page banner, e.g. 'Made for everyday'."
  },
  {
   "permlevel": 1,
   "fieldname": "storefront_tagline",
   "fieldtype": "Small Text",
   "label": "Tagline",
   "description": "One or two sentences under the headline."
  },
  {
   "permlevel": 1,
   "fieldname": "storefront_hero_image",
   "fieldtype": "Attach Image",
   "label": "Banner Image",
   "description": "Wide photo behind the headline (optional; a brand-coloured band is used without one)."
  },
  {
   "fieldname": "capabilities_tab",
   "fieldtype": "Tab Break",
   "label": "Capabilities"
  },
  {
   "fieldname": "core_section",
   "fieldtype": "Section Break",
   "label": "Core (always on)",
   "description": "Stock, Selling, Accounts and POS are always enabled. Customers can be created straight from POS without the CRM module."
  },
  {
   "fieldname": "enable_loyalty",
   "fieldtype": "Check",
   "label": "Loyalty Program",
   "default": "1",
   "description": "Creates (or re-enables) a default points program and enrols new customers automatically."
  },
  {
   "fieldname": "default_loyalty_program",
   "fieldtype": "Link",
   "label": "Default Loyalty Program",
   "options": "Loyalty Program",
   "read_only": 1
  },
  {
   "fieldname": "group_variants_in_pos",
   "fieldtype": "Check",
   "label": "Group Variants in POS",
   "default": "1",
   "description": "POS shows one card per product (e.g. one per shoe model) and asks for Size/Colour when it is tapped. Scanning a barcode still adds the exact variant. Turn off to get ERPNext's standard one-card-per-variant list."
  },
  {
   "fieldname": "optional_section",
   "fieldtype": "Section Break",
   "label": "Optional Modules",
   "description": "Off by default. Ticking one un-hides its sidebar icon and grants it to Store Owner. Saving re-applies the navigation.",
   "permlevel": 1
  },
  {
   "fieldname": "enable_crm",
   "fieldtype": "Check",
   "label": "CRM (Leads, Opportunities, pipeline)",
   "default": "0",
   "permlevel": 1
  },
  {
   "fieldname": "enable_ecommerce",
   "fieldtype": "Check",
   "label": "Online Store / E-Commerce (needs the webshop app)",
   "default": "0",
   "permlevel": 1
  },
  {
   "fieldname": "enable_buying",
   "fieldtype": "Check",
   "label": "Buying (Suppliers, Purchase Orders)",
   "default": "0",
   "permlevel": 1
  },
  {
   "fieldname": "enable_hr",
   "fieldtype": "Check",
   "label": "HR (needs the hrms app)",
   "default": "0",
   "permlevel": 1
  },
  {
