 "fields": [
  {
   "fieldname": "branding_tab",
   "fieldtype": "Tab Break",
   "label": "Branding",
   "permlevel": 1
  },
  {
   "fieldname": "brand_name",
   "fieldtype": "Data",
   "label": "Brand Name",
   "description": "Shown in the navbar and browser title. Leave empty to use the Company name.",
   "permlevel": 1
  },
  {
   "fieldname": "brand_logo",
   "fieldtype": "Attach Image",
   "label": "Brand Logo",
   "description": "Use a square mark (e.g. 256x256 PNG/SVG): it is shown as the app icon on the apps screen and in the desk.",
   "permlevel": 1
  },
  {
   "fieldname": "brand_favicon",
   "fieldtype": "Attach Image",
   "label": "Favicon",
   "permlevel": 1
