   "permlevel": 1
  },
  {
   "fieldname": "brand_color",
   "fieldtype": "Color",
   "label": "Brand Colour",
   "default": "#1F6FEB",
   "permlevel": 1
  },
  {
   "fieldname": "accent_color",
   "fieldtype": "Color",
   "label": "Accent Colour",
   "default": "#F59E0B",
   "permlevel": 1
