  {
   "fieldname": "location_scoped_doctypes",
   "fieldtype": "Small Text",
   "label": "Doctypes Restricted by Location",
   "default": "Sales Invoice\nPOS Invoice\nPOS Profile\nSales Order\nDelivery Note\nStock Reconciliation",
   "description": "One per line. A staff member's warehouses are applied to these doctypes as native User Permissions ('Applicable For'). Stock Entry and Material Request are always scoped by this app, and reports like Stock Balance are never blocked."
  },
  {
   "fieldname": "pos_scoped_doctypes",
   "fieldtype": "Small Text",
   "label": "Doctypes Restricted by POS Profile",
   "default": "POS Opening Entry\nPOS Closing Entry",
   "description": "One per line. Restricted to the POS Profiles of the staff member's warehouses."
  },
