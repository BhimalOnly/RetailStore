  {
   "fieldname": "grants_section",
   "fieldtype": "Section Break",
   "label": "Extra Staff Permissions",
   "description": "By default shop-floor staff sell, count stock and request stock transfers. Nothing else. Add a person here to let them do more. Only the Store Owner can change this list."
  },
  {
   "fieldname": "staff_grants",
   "fieldtype": "Table",
