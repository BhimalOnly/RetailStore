   "fieldtype": "Section Break",
   "label": "Leave & Overtime Defaults",
   "description": "Starting points written to Leave Types and the Overtime Type when HR is on. Verify against the Workers' Rights Act 2019 before relying on them: sources disagree on annual leave (20 vs 22 days).",
   "depends_on": "eval:doc.enable_hr"
  },
  {
   "fieldname": "hr_annual_leave_days",
   "fieldtype": "Float",
   "label": "Annual Leave (days / year)",
   "default": "20",
   "depends_on": "eval:doc.enable_hr"
  },
  {
   "fieldname": "hr_sick_leave_days",
   "fieldtype": "Float",
   "label": "Sick Leave (days / year)",
   "default": "0",
   "depends_on": "eval:doc.enable_hr",
   "description": "Leave 0 until confirmed from the Act; no Sick Leave type is created while this is 0."
  },
  {
   "fieldname": "column_break_hr1",
   "fieldtype": "Column Break",
   "label": "",
   "depends_on": "eval:doc.enable_hr"
  },
  {
   "fieldname": "hr_overtime_multiplier",
   "fieldtype": "Float",
   "label": "Overtime Pay Multiplier",
   "default": "1.5",
   "depends_on": "eval:doc.enable_hr"
  },
  {
   "fieldname": "hr_rest_day_multiplier",
   "fieldtype": "Float",
   "label": "Rest Day / Public Holiday Multiplier",
   "default": "2",
   "depends_on": "eval:doc.enable_hr",
